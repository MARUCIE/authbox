<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- P0: App Sandbox required for a credential broker (containment over prevention). -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- .env drag-drop import (P3) needs user-selected file read. -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<!-- P4: local MCP Gateway broker is loopback-only; allow outbound for optional Go-API sync. -->
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- P4: bind the local MCP Gateway server socket (ws://127.0.0.1:19876). -->
	<key>com.apple.security.network.server</key>
	<true/>
	<!--
	  Required for persistent Secure Enclave keys. macOS keys the SE-resident
	  private key into this team-prefixed access group; without it SecKeyCreateRandomKey
	  fails errSecMissingEntitlement (-34018). $(AppIdentifierPrefix) expands to the
	  team prefix (35HKS5847W.) at sign time; com.authbox.mac is the app's own group,
	  which is the default group the SecureEnclaveKeyStore queries use. Verified
	  2026-06-01: signed entitlements carry 35HKS5847W.com.authbox.mac.
	-->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)com.authbox.mac</string>
	</array>
</dict>
</plist>
