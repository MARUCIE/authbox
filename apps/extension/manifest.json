{
  "manifest_version": 3,
  "name": "Auth Box",
  "version": "2.0.0",
  "description": "Zero-knowledge password manager & AI agent gateway",
  "permissions": ["storage", "activeTab", "alarms"],
  "host_permissions": [
    "http://localhost:4010/*",
    "https://api.authbox.io/*",
    "https://authbox.io/*"
  ],
  "action": {
    "default_popup": "src/popup/index.html",
    "default_icon": {
      "16": "public/icons/icon-16.png",
      "32": "public/icons/icon-32.png",
      "48": "public/icons/icon-48.png",
      "128": "public/icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "src/background/index.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://*/*", "http://*/*"],
      "exclude_matches": [
        "http://localhost/*",
        "http://127.0.0.1/*",
        "https://authbox.io/*",
        "https://*.authbox.io/*"
      ],
      "js": ["src/content/index.ts"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "public/icons/icon-16.png",
    "32": "public/icons/icon-32.png",
    "48": "public/icons/icon-48.png",
    "128": "public/icons/icon-128.png"
  }
}
